{
  "name": "@goldlabelapps/flash",
  "version": "0.1.1",
  "private": false,
  "description": "A public React/TypeScript animation library inspired by the Flash programming model.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "pnpm dev:library & pnpm --dir example dev",
    "dev:library": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:consumer": "node --input-type=module -e \"import { Flash } from './dist/index.js'; if (!Flash || typeof Flash.render !== 'function') throw new Error('Flash export missing'); console.log('Consumer import ok');\""
  },
  "keywords": [
    "react",
    "typescript",
    "animation",
    "flash",
    "library"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
